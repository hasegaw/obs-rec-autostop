# Match the settings in OBS under Tools > WebSocket Server Settings.
OBS_WS_URL=ws://127.0.0.1:4455
OBS_WS_PASSWORD=''

# Stop recording when audio stays at or below the threshold for this duration.
SILENCE_DURATION=10m
SILENCE_THRESHOLD_DB=-50

# An empty array monitors all active audio inputs. Names must exactly match OBS.
# OBS_AUDIO_INPUTS='["Desktop Audio","Mic/Aux"]'
OBS_AUDIO_INPUTS='[]'

# If meters remain missing for this duration, exit with an error without stopping recording.
METER_TIMEOUT=5s
REQUEST_TIMEOUT=10s
